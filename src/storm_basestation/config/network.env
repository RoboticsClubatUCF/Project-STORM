# Static IPs on the rover <-> base station radio link (192.168.1.0/24).
# Read by check_link.sh and docker-compose.yml. Keep fastdds_peers.xml in sync.
ROVER_IP=192.168.1.50
BASE_IP=192.168.1.60
ROVER_RADIO_IP=192.168.1.21
BASE_RADIO_IP=192.168.1.20
LINK_PREFIX=24
# Base Jetson port to the radio; link_up.sh auto-detects it when unset
# LINK_IFACE=eth0
