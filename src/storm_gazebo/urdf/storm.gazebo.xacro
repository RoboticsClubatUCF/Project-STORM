<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="storm">
  <xacro:arg name="hardware" default="gazebo"/>
  <xacro:arg name="truth_pose" default="false"/>
  <xacro:include filename="$(find storm_description)/urdf/storm.urdf.xacro"/>
  <xacro:include filename="$(find storm_gazebo)/urdf/gazebo_plugins.xacro"/>
</robot>
