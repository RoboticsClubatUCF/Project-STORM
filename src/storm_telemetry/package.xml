<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>storm_telemetry</name>
  <version>0.1.0</version>
  <description>Rover-side health publishers: CAN bus, onboard computer, WiFi, battery</description>
  <maintainer email="vcadicamo@icloud.com">Vincent Cadicamo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>diagnostic_updater</depend>
  <depend>diagnostic_msgs</depend>
  <depend>control_msgs</depend>
  <depend>storm_interfaces</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
