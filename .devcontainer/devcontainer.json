{
  "name": "Project STORM ROS 2 Jazzy",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=/mnt/wslg/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=/mnt/wslg,target=/mnt/wslg,type=bind",
    "source=/usr/lib/wsl,target=/usr/lib/wsl,type=bind"
  ],
  "hostRequirements": {
    "gpu": true
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},
  "runArgs": [
    "--ipc=host",
    "--network=host",
    "--device=/dev/dxg",
    "--gpus",
    "all"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "remoteEnv": {
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "forwardPorts": [
    8764,
    8765
  ],
  "postCreateCommand": "bash devscripts/download_ros_pkgs.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python"
      ]
    }
  }
}